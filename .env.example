# JWT signing secret (REQUIRED — the backend refuses to start without it).
# MUST be a long random value unique per deployment. A publicly-known or default
# secret lets anyone forge JWTs for any tenant/role (CRITICAL).
# Generate one with: openssl rand -base64 48
# NOTE: this placeholder intentionally FAILS validation (too short) so copying
# .env.example verbatim cannot accidentally deploy with a known secret.
JWT_SECRET=CHANGE_ME

# PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transparansi_rt
POSTGRES_PORT=5432

# MinIO Config
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Tenant subdomain base domain.
# Dev:   openrt.local  -> rt-003.openrt.local
# Prod:  openrt.com    -> rt-003.openrt.com
# Backend reads TENANT_BASE_DOMAIN; the frontend bundle bakes the same value via
# the VITE_TENANT_BASE_DOMAIN build arg (see Dockerfile.frontend).
# Wildcard DNS (*.<TENANT_BASE_DOMAIN>) is only routing: the backend resolves and
# authorizes every tenant hostname against the tenants table.
TENANT_BASE_DOMAIN=openrt.local

# Rate limiting (per-client-IP token bucket). Each source IP gets its own
# budget, so one abusive client cannot 429 the whole API for everyone.
# /health and /swagger are always exempt. Defaults: capacity 1000, refill 100/s.
RATE_LIMIT_CAPACITY=1000
RATE_LIMIT_REFILL=100

# Stricter per-IP budget for public auth endpoints (/login, /register) — the
# brute-force surface. Defaults: capacity 20, refill 5/s.
AUTH_RATE_LIMIT_CAPACITY=20
AUTH_RATE_LIMIT_REFILL=5

# Reverse proxies in front of the backend (comma-separated, exact IP or CIDR)
# whose X-Forwarded-For header is honored for per-IP rate limiting.
# REQUIRED in production when the backend sits behind Traefik/Nginx — otherwise
# all requests share the proxy's IP and are limited as one client.
# CIDR is handy for Docker: the proxy's container IP changes per recreate but
# stays in the same network subnet (e.g. 172.16.0.0/12).
# Dev/E2E (requests via the nginx frontend container): leave empty.
TRUSTED_PROXY_IPS=
