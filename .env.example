# JWT signing secret (REQUIRED — the backend refuses to start without it).
# MUST be a long random value unique per deployment. A publicly-known or default
# secret lets anyone forge JWTs for any tenant/role (CRITICAL).
# Generate one with: openssl rand -base64 48
# NOTE: this placeholder intentionally FAILS validation (too short) so copying
# .env.example verbatim cannot accidentally deploy with a known secret.
JWT_SECRET=CHANGE_ME

# PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transparansi_rt
POSTGRES_PORT=5432

# MinIO Config
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Tenant subdomain base domain.
# Dev:   openrt.local  -> rt-003.openrt.local
# Prod:  openrt.com    -> rt-003.openrt.com
# Backend reads TENANT_BASE_DOMAIN; the frontend bundle bakes the same value via
# the VITE_TENANT_BASE_DOMAIN build arg (see Dockerfile.frontend).
# Wildcard DNS (*.<TENANT_BASE_DOMAIN>) is only routing: the backend resolves and
# authorizes every tenant hostname against the tenants table.
TENANT_BASE_DOMAIN=openrt.local
