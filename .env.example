# ==============================================================================
# SITRANSPARAN RT/RW - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env di direktori infrastructure/
# atau gunakan variabel environment ini sesuai target deployment.

# --- KEAMANAN & AUTENTIKASI (WAJIB) ---
# Generate secret baru dengan: openssl rand -base64 48
JWT_SECRET=production-or-staging-secret-key-min-32-chars-length

# --- DATABASE POSTGRESQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Dev:     transparansi_rt_dev
# Staging: transparansi_rt
# Prod:    transparansi_rt_prod
POSTGRES_DB=transparansi_rt_dev

# --- STORAGE S3 / MINIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sitransparan-files
MINIO_USE_SSL=false

# --- DOMAIN UTAMA & MULTI-TENANCY ---
# Dev / Staging / Prod: iscube.web.id
TENANT_BASE_DOMAIN=iscube.web.id

# --- RATE LIMITER & PROXY TRUST ---
# Kosongkan jika di development lokal.
# Di production/staging di belakang Cloudflare/Traefik, isi subnet CIDR Docker atau IP proxy.
TRUSTED_PROXY_IPS=

# --- WEB PUSH NOTIFICATION (VAPID) ---
# Kosongkan jika belum mengaktifkan push notification
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@iscube.web.id
